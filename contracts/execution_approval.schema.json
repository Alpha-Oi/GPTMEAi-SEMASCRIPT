    },
    "preview_id": {
      "type": "string"
    },
    "approved": {
      "type": "boolean"
    },
    "approved_by": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
