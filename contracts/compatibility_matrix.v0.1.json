  "semascript_action_document": {
    "fields": [
      {
        "name": "version",
        "status": "required",
        "required": true,
        "validation": "must be a non-empty string",
        "mapping": "not copied into planner preview except preview uses bridge version 0.1",
        "failure": "validation error"
      },
      {
        "name": "source",
        "status": "required",
        "required": true,
        "validation": "must be an object with source.system equal to SEMASCRIPT",
        "mapping": "source.system and source.document_id map into planner preview metadata",
        "failure": "validation error"
      },
      {
        "name": "intent",
        "status": "required",
        "required": true,
        "validation": "must be an object with non-empty intent.summary",
        "mapping": "intent.summary maps into planner preview metadata.intent_summary",
        "failure": "validation error"
      },
      {
        "name": "actions[]",
        "status": "required",
        "required": true,
        "validation": "must be a non-empty array; each action requires id, type, and description",
        "mapping": "each action maps into mapped_actions[] with dry_run execution_mode",
        "failure": "validation error"
      },
      {
        "name": "constraints",
        "status": "required",
        "required": true,
        "validation": "must be an object",
        "mapping": "validated for shape but not mapped into planner preview fields in v0.1",
        "failure": "validation error"
      },
      {
        "name": "safety",
        "status": "required",
        "required": true,
        "validation": "must be an object; dry_run_only and requires_approval must be true",
        "mapping": "enforced by validator and approval gate behavior",
        "failure": "validation error"
      },
      {
        "name": "metadata",
        "status": "required",
        "required": true,
        "validation": "must be an object",
        "mapping": "used as source metadata only when adapter code explicitly reads keys",
        "failure": "validation error"
      }
    ]
  },
