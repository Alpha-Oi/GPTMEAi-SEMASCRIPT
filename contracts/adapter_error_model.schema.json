{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gptmeai-semascript.local/contracts/adapter_error_model.schema.json",
  "title": "Adapter Error Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error_code",
    "message",
    "severity",
    "source",
    "retryable",
    "details"
  ],
  "properties": {
    "error_code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "source": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object"
    }
  }
}
